[Unit]
Description=Meme Coin Intelligence — continuous scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO_DIR__/.venv/bin/python -m meme_intelligence monitor --pumpfun
Restart=always
RestartSec=10
# Belt-and-suspenders on top of the app's own exponential backoff (Rule 7):
# if the process itself dies outright, systemd brings it back.
StartLimitIntervalSec=0

# OOM backstop only — sized for the learning layer, which grows with every
# resolved coin (~740M at 6,362 coins, 2026-07-11). The old 512M cap caused
# an OOM crash-loop once memory grew past it, and an intermediate
# MemoryHigh=700M soft limit stalled the whole process in kernel reclaim
# (avoid MemoryHigh here: anon-heavy Python + reclaim pressure = livelock).
#
# 1400M since the 2026-07-31 upsize to a 2 GB / 2 vCPU droplet (verified:
# `free -h` = 1.9Gi total, 3.0Gi swap). Sizing rule: ~70% of RAM, leaving
# headroom for the OS and for the cron jobs (daily routine, backtest
# --refresh, DB backup), which are SEPARATE Python processes that run while
# the monitor is live. The old 880M was sized for a 1 GB box and had become
# a real crash risk: the database now holds ~57k tokens and the learning
# layer's footprint grows with resolved coins, so it was heading for the
# same OOM crash-loop that hit on 2026-07-11.
#
# Override per-host without editing this file (survives git pull):
#   /etc/systemd/system/meme-intelligence.service.d/memory.conf
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
