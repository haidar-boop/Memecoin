[Unit]
Description=Meme Coin Intelligence — continuous scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO_DIR__/.venv/bin/python -m meme_intelligence monitor --pumpfun
Restart=always
RestartSec=10
# State the stop budget rather than inheriting systemd's invisible 90s
# default. The app now wakes from its cycle/backoff sleep on SIGTERM, so a
# clean stop takes about as long as the in-flight cycle; this bounds the
# worst case and keeps a phone-issued `systemctl restart` responsive.
TimeoutStopSec=45
# Belt-and-suspenders on top of the app's own exponential backoff (Rule 7):
# if the process itself dies outright, systemd brings it back.
StartLimitIntervalSec=0

# OOM backstop only — sized for the learning layer, which grows with every
# resolved coin (~740M at 6,362 coins, 2026-07-11). The old 512M cap caused
# an OOM crash-loop once memory grew past it, and an intermediate
# MemoryHigh=700M soft limit stalled the whole process in kernel reclaim
# (avoid MemoryHigh here: no-swap droplets + anon-heavy Python = livelock).
# Pair with a 1G swapfile on 1GB droplets — see handoff/OPERATIONS.md.
MemoryMax=880M

[Install]
WantedBy=multi-user.target
