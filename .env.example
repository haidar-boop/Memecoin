# Meme Coin Intelligence System — configuration reference
#
# Copy to `.env` and adjust as needed. Every value below shows its default;
# unset variables fall back to the specification defaults in
# meme_intelligence/config/settings.py. NEVER commit a real .env file.

# ---- Logging ---------------------------------------------------------------
#MEMEINTEL_LOG_LEVEL=INFO
#MEMEINTEL_LOG_DIR=logs

# ---- Scoring weights (Part 31 Consistency Lock; must sum to 1.0) -----------
#MEMEINTEL_WEIGHTS_FOUNDATION=0.15
#MEMEINTEL_WEIGHTS_SECURITY=0.15
#MEMEINTEL_WEIGHTS_COMMUNITY=0.15
#MEMEINTEL_WEIGHTS_BLOCKCHAIN=0.15
#MEMEINTEL_WEIGHTS_MOMENTUM=0.15
#MEMEINTEL_WEIGHTS_NARRATIVE=0.15
#MEMEINTEL_WEIGHTS_TIMING=0.10

# ---- Security sub-weights (Part 33 Section 10; must sum to 1.0) ------------
#MEMEINTEL_SECURITY_WEIGHTS_CONTRACT=0.25
#MEMEINTEL_SECURITY_WEIGHTS_LIQUIDITY=0.25
#MEMEINTEL_SECURITY_WEIGHTS_DISTRIBUTION=0.20
#MEMEINTEL_SECURITY_WEIGHTS_DEVELOPER=0.15
#MEMEINTEL_SECURITY_WEIGHTS_MANIPULATION=0.15

# ---- Classification bands (Parts 10/12/20; strictly descending) ------------
#MEMEINTEL_BANDS_ELITE=90
#MEMEINTEL_BANDS_STRONG_CANDIDATE=80
#MEMEINTEL_BANDS_WATCHLIST=70
#MEMEINTEL_BANDS_SPECULATIVE=60

# ---- Human-review alert thresholds (Part 2 Section 4) ----------------------
#MEMEINTEL_ALERTS_SECURITY=80
#MEMEINTEL_ALERTS_COMMUNITY=70
#MEMEINTEL_ALERTS_LIQUIDITY=70
#MEMEINTEL_ALERTS_ONCHAIN=75
#MEMEINTEL_ALERTS_OVERALL=85

# ---- Scan intervals in seconds (Part 21 Section 4) --------------------------
#MEMEINTEL_INTERVALS_ULTRA_FAST=7
#MEMEINTEL_INTERVALS_FAST=45
#MEMEINTEL_INTERVALS_RESEARCH=600
#MEMEINTEL_INTERVALS_HISTORICAL=86400

# ---- HTTP client behavior ---------------------------------------------------
#MEMEINTEL_HTTP_TIMEOUT_SECONDS=10
#MEMEINTEL_HTTP_RETRY_ATTEMPTS=4
#MEMEINTEL_HTTP_RETRY_BASE_DELAY=0.5
#MEMEINTEL_HTTP_RETRY_MAX_DELAY=8
#MEMEINTEL_HTTP_CACHE_TTL_SECONDS=30
#MEMEINTEL_HTTP_CACHE_MAX_ENTRIES=2048

# ---- Providers (rate limits kept below documented provider limits) ----------
#MEMEINTEL_PROVIDERS_DEXSCREENER_BASE_URL=https://api.dexscreener.com
#MEMEINTEL_PROVIDERS_DEXSCREENER_REQUESTS_PER_MINUTE=240
#MEMEINTEL_PROVIDERS_GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com
#MEMEINTEL_PROVIDERS_GECKOTERMINAL_REQUESTS_PER_MINUTE=25
#MEMEINTEL_PROVIDERS_GOPLUS_BASE_URL=https://api.gopluslabs.io
#MEMEINTEL_PROVIDERS_GOPLUS_REQUESTS_PER_MINUTE=20
#MEMEINTEL_PROVIDERS_FAILURE_THRESHOLD=3
#MEMEINTEL_PROVIDERS_COOLDOWN_SECONDS=60

