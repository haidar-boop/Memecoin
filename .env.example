# ---- Self-learning "mind" layer (analog + model + rug) --------------------------
# A reasoning layer that remembers every coin, recognizes when a new coin
# resembles past coins, forecasts the outcome from those analogs, and flags
# rugs. Opt-in and off by default (needs the numpy/faiss/lightgbm stack in
# requirements.txt). `enabled` is the global switch; `enable_in_monitor` also
# feeds the 24/7 scanner. CLI: `mind evaluate <address>` / `mind metrics`.
#MEMEINTEL_LEARNING_ENABLED=false
#MEMEINTEL_LEARNING_ENABLE_IN_MONITOR=false
# Outcome label buckets (return %, relative to detection price):
#MEMEINTEL_LEARNING_PUMP_RETURN_PERCENT=50
#MEMEINTEL_LEARNING_DUMP_RETURN_PERCENT=-50
#MEMEINTEL_LEARNING_HORIZONS_HOURS=0.25,1,6,24
# Analog / FAISS k-NN forecasting:
#MEMEINTEL_LEARNING_KNN_NEIGHBORS=25
#MEMEINTEL_LEARNING_RECENCY_HALF_LIFE_DAYS=30
#MEMEINTEL_LEARNING_MIN_ANALOG_NEIGHBORS=5
# Archetype clustering + novelty (min cluster size must be >= 2):
#MEMEINTEL_LEARNING_ARCHETYPE_MIN_CLUSTER_SIZE=15
#MEMEINTEL_LEARNING_NOVELTY_PERCENTILE=90
# LightGBM warm-start classifier:
#MEMEINTEL_LEARNING_RETRAIN_EVERY_N=200
#MEMEINTEL_LEARNING_MODEL_HALF_LIFE_DAYS=30
#MEMEINTEL_LEARNING_MIN_TRAIN_SAMPLES=50
# Adaptive ensemble + drift handling (drift = blended-verdict accuracy below
# the floor over at least drift_min_samples graded outcomes -> full rebuild):
#MEMEINTEL_LEARNING_ACCURACY_WINDOW=200
#MEMEINTEL_LEARNING_DRIFT_ACCURACY_FLOOR=0.40
#MEMEINTEL_LEARNING_DRIFT_MIN_SAMPLES=30
#MEMEINTEL_LEARNING_SCALER_REFIT_EVERY_N=500
# Cold start (below this many resolved coins, confidence is scaled down):
#MEMEINTEL_LEARNING_COLD_START_SAMPLES=100
#MEMEINTEL_LEARNING_MIN_SNAPSHOTS_FOR_CONFIDENCE=3
# Where the SQLite db + FAISS index + models are persisted:
#MEMEINTEL_LEARNING_STATE_DIR=learning_state

# ---- LightGBM hyperparameters (mind-layer classifier, Section 4) ----------------
#MEMEINTEL_LIGHTGBM_FULL_RETRAIN_ROUNDS=120
#MEMEINTEL_LIGHTGBM_WARM_START_ROUNDS=30
#MEMEINTEL_LIGHTGBM_LEARNING_RATE=0.05
#MEMEINTEL_LIGHTGBM_NUM_LEAVES=31
#MEMEINTEL_LIGHTGBM_MIN_CHILD_SAMPLES=5
# Upweight rare classes (rugs/pumps) so the majority class can't dominate:
#MEMEINTEL_LIGHTGBM_BALANCED_CLASS_WEIGHTS=true

# ---- Rug-signal firing thresholds (mind-layer rug engine, Section 5a) -----------
#MEMEINTEL_RUG_THRESHOLDS_MIN_LP_LOCKED_PERCENT=50
#MEMEINTEL_RUG_THRESHOLDS_TOP_HOLDER_PERCENT_MAX=30
#MEMEINTEL_RUG_THRESHOLDS_TOP10_HOLDER_PERCENT_MAX=70
#MEMEINTEL_RUG_THRESHOLDS_LIQUIDITY_DROP_PERCENT=50
#MEMEINTEL_RUG_THRESHOLDS_LIQUIDITY_REMOVAL_USD=1000
#MEMEINTEL_RUG_THRESHOLDS_SELL_TAX_MAX_PERCENT=20
#MEMEINTEL_RUG_THRESHOLDS_DEV_DUMP_USD=1000
#MEMEINTEL_RUG_THRESHOLDS_FAKE_VOLUME_PER_HOLDER_USD=5000
#MEMEINTEL_RUG_THRESHOLDS_FAKE_VOLUME_MIN_VOLUME_USD=1000

# ---- Rug-signal point weights (mind-layer rug engine; additive, summed to 0-100) 
#MEMEINTEL_RUG_SIGNAL_WEIGHTS_LIQUIDITY_UNLOCKED=20
#MEMEINTEL_RUG_SIGNAL_WEIGHTS_MINT_AUTHORITY_ACTIVE=20
#MEMEINTEL_RUG_SIGNAL_WEIGHTS_FREEZE_AUTHORITY_ACTIVE=15
#MEMEINTEL_RUG_SIGNAL_WEIGHTS_TOP_HOLDER_CONCENTRATION=15
